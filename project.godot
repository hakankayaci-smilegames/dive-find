; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dive&Find"
run/main_scene="uid://ct2wcuidga1m2"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/stretch_mode=0
boot_splash/image="res://Sprites/icon.svg"
config/icon="res://Sprites/icon.svg"

[autoload]

GlobalInventory="*uid://ccmupnkmax1lb"
GlobalEconomy="*uid://ce5nrs0re56j3"
GlobalSoundManager="*uid://bh56jss3gi8tp"
GlobalTime="*uid://3ocp1jsxbexj"
DevConsole="*uid://c0ns0l3dev001"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[global_group]

player=""

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
